{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 build/build_zwo.py > /dev/null && python3 build/build_dash.py",
  "outputDirectory": "web",
  "functions": {
    "api/garmin.py": {
      "includeFiles": "server/garmin_client.py",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/garmin/:path*",
      "destination": "/api/garmin?p=:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(index\\.html|config\\.js|sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}

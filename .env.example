# Kopie als .env anlegen (wird nicht eingecheckt). Werte per `set -a; . ./.env; set +a` laden oder
# bei Docker über env_file. Diese Datei enthält absichtlich keine echten Werte.

# Wer die App von außerhalb des Rechners erreichen soll, braucht ein Passwort (Browser-Anmeldung).
APP_PASSWORD=
HOST=127.0.0.1
PORT=8080

# Garmin Personal API Key. Alternativ: Datei data/garmin_key (nur der Schlüssel, chmod 600).
GARMIN_PERSONAL_API_KEY=
